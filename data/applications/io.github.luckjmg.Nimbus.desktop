[Desktop Entry]
Type=Application
Name=Nimbus
GenericName=Cloud sync
Comment=Sync a local folder with an rclone remote
Exec=/usr/bin/nimbus
Icon=nimbus-idle-symbolic
Terminal=false
Categories=Network;FileTransfer;
Keywords=cloud;drive;sync;backup;rclone;
# The tray stays up after the window closes, so the shell gets no window to
# wait for. A false value also leaves no spinning pointer when the start fails.
StartupNotify=false
# This key counts only in ~/.config/autostart. The install recipes copy the
# file there and add --hidden to Exec, so a login opens no window.
X-GNOME-Autostart-enabled=true
